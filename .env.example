# Copy to .env (cp .env.example .env / Copy-Item .env.example .env) and edit.
# Every value except the Mercado Libre credentials has a working default.

# --- Mercado Libre API (required for the extraction step) ---------------------
ML_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID
ML_CLIENT_SECRET=REPLACE_WITH_YOUR_CLIENT_SECRET
ML_GRANT_TYPE=client_credentials

# --- Analytics PostgreSQL (reference, staging and final tables) ---------------
# Credentials are applied when the volume is first created; to change them
# later, run `docker compose down -v` (deletes the data) and start again.
POSTGRES_DB=snowflake_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port (5434 avoids clashing with a PostgreSQL installed on the host).
POSTGRES_EXTERNAL_PORT=5434

# --- Dagster metadata database (internal) -------------------------------------
DAGSTER_POSTGRES_PASSWORD=dagster

# --- MinIO data lake (user >= 3 chars, password >= 8 chars) -------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=meli-datalake

# --- Superset -----------------------------------------------------------------
# Generate a long random value, e.g. `openssl rand -base64 42` (Linux) or
# `[Convert]::ToBase64String((1..42 | % {Get-Random -Max 256}))` (PowerShell).
SUPERSET_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin

# --- Pipeline behaviour -------------------------------------------------------
PIPELINE_TIMEZONE=America/Argentina/Buenos_Aires
# Daily run (cron, evaluated in PIPELINE_TIMEZONE).
PIPELINE_SCHEDULE_CRON="0 23 * * *"
# Run the whole pipeline once right after the first `docker compose up -d`.
PIPELINE_RUN_ON_STARTUP=true
# true: only subcategories with id_seleccionado = 1 in mercado_libre_subcat.xlsx.
MELI_SELECTED_SUBCATEGORIES_ONLY=true
# Parallel calls to the Mercado Libre API.
MELI_MAX_WORKERS=4
# One-letter typo correction for long brand/character names (see README).
MATCHING_FUZZY_ENABLED=true

# --- Published ports ----------------------------------------------------------
# 127.0.0.1 keeps every UI and database private to this machine. Use 0.0.0.0
# only on a trusted network: the services ship with default credentials.
HOST_BIND_IP=127.0.0.1
DAGSTER_PORT=3000
SUPERSET_PORT=8088
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
DOZZLE_PORT=8888
ADMINER_PORT=8082
